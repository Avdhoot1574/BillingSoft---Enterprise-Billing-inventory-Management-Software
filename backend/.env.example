# Copy to .env (python scripts/setup_db.py does this for you) and edit the password.
APP_ENV=dev

# postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
# user/password = what you chose when installing PostgreSQL (the same ones pgAdmin asks for).
# Special characters in the password must be URL-encoded: @ -> %40   : -> %3A   / -> %2F   # -> %23
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/billing

# Optional. Default is the main database name + _test  (billing_test). Tests WIPE this database.
# TEST_DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/billing_test

# Generate your own:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-secret-change-me-dev-only-secret

# Dev only: return invitation tokens in the API response until email sending exists.
EXPOSE_INVITATION_TOKENS=true
